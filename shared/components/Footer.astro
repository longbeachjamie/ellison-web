---
type Props = {
  siteName: string;
  domain: string;
};

const { siteName, domain } = Astro.props;
const year = new Date().getFullYear();
---

<footer>
  <div class="container footer-inner">
    <p>{siteName} | {domain}</p>
    <p>&copy; {year} {siteName}. All rights reserved.</p>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid #e2e8f0;
    background: var(--surface-soft);
  }

  .footer-inner {
    padding: 1.25rem 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.92rem;
    color: #334155;
  }

  p {
    margin: 0;
  }
</style>
